DART_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
ANTHROPIC_API_KEY=

# LLM 설정
# LLM_PROVIDER: anthropic 또는 openai (OpenAI 호환 API: Gemini, OpenAI, Ollama 등)
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=               # Gemini: aistudio.google.com 에서 발급
LLM_MODEL=gemini-2.5-flash   # python -m src.s04_extract_tags --list-models 로 확인 후 수정
LLM_SLEEP=6                # 호출 간격(초). 무료 할당량 분당 제한에 맞춤
LLM_MAX_TOKENS=8000
LLM_MAX_CHARS=40000        # 한 번에 LLM에 넣을 섹션 최대 글자 수 (넘으면 나눠서 호출)
TAG_MAX_PER_AXIS=5         # 프롬프트에서 축당 최대 개수
TAG_MAX_PRODUCT=8          # product 축 최대 개수 (세부 품목)

# OpenDART 호출 간격(초)
DART_SLEEP=0.3
